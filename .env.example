# --- Required for Docker Compose ---
# Absolute path to dataset root (fleet/ + assets/). Use sample-data or test-data/dataset.
DATASET_HOST_PATH=/absolute/path/to/flytbase-ahc-swe-asset-intelligence-dataset/sample-data
# sample | test — drives Makefile defaults for clock + import version
DATASET_PROFILE=sample

# --- Runtime ---
APP_ENV=development
LOG_LEVEL=INFO
# sample today = 2026-10-16; test today = 2027-01-15
EVALUATION_AS_OF=2026-10-16T00:00:00Z
APP_TIMEZONE=UTC
SOURCE_ROOT=/data/sample-data

# Postgres (Compose interpolates these into DATABASE_URL)
POSTGRES_USER=fieldsense
POSTGRES_PASSWORD=fieldsense
POSTGRES_DB=fieldsense
DATABASE_URL=postgresql+psycopg://fieldsense:fieldsense@db:5432/fieldsense

# Browser origins (comma-separated). Never use * in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Cookie/session signing — use a long random value in production
SESSION_SECRET=change-me-in-real-deployments

# Demo identity picker (challenge). Keep true for Hack Day; disable for real auth.
DEMO_USER_PICKER_ENABLED=true

# Answers come from Gemma on the Gemini API. The phrase router is optional.
# ANSWER_MODE=llm | router
ANSWER_MODE=llm
MODEL_PROVIDER=google
# Faster: gemma-4-26b-a4b-it   Stronger: gemma-4-31b-it
MODEL_NAME=gemma-4-26b-a4b-it
# Create at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Only for MODEL_PROVIDER=openai_compatible (OpenAI, Ollama, other /v1 servers)
MODEL_BASE_URL=
MODEL_API_KEY=
EMBEDDING_MODEL=

TOOL_CALL_LIMIT=8
AGENT_MAX_RESULT_ROWS=500
